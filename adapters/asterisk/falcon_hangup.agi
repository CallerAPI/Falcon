#!/usr/bin/env python3
"""Asterisk h-extension AGI. Reports how the call ended to Falcon and, when
Falcon asked for a clip, uploads the MixMonitor recording. Copy next to
falcon.agi in agi-bin and make it executable."""

import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request

FALCON_URL = os.environ.get("FALCON_URL", "http://127.0.0.1:8090/v1/screen")
BASE = FALCON_URL[: -len("/v1/screen")] if FALCON_URL.endswith("/v1/screen") else FALCON_URL
FALCON_TOKEN = os.environ.get("FALCON_TOKEN", "")


def read_env():
    while True:
        line = sys.stdin.readline()
        if not line or line in ("\n", "\r\n"):
            break


def agi(cmd):
    sys.stdout.write(cmd + "\n")
    sys.stdout.flush()
    return sys.stdin.readline()


def var(name):
    resp = agi('GET VARIABLE %s' % name)
    if "(" in resp and ")" in resp:
        return resp[resp.index("(") + 1 : resp.rindex(")")]
    return ""


def headers():
    h = {"Content-Type": "application/json"}
    if FALCON_TOKEN:
        h["X-Falcon-Token"] = FALCON_TOKEN
    return h


def main():
    read_env()
    call_id = var("FALCON_CALL_ID") or var("PJSIP_HEADER(read,Call-ID)") or var("SIP_HEADER(Call-ID)")
    if not call_id or call_id == "(null)":
        return
    answered = (var("ANSWEREDTIME") or "0") not in ("", "0")
    duration = int(var("ANSWEREDTIME") or "0")
    cause = var("HANGUPCAUSE") or ""
    body = json.dumps({"call_id": call_id, "answered": answered, "duration_s": duration, "hangup_cause": cause}).encode()
    try:
        req = urllib.request.Request(BASE + "/v1/outcome", data=body, method="POST", headers=headers())
        urllib.request.urlopen(req, timeout=2).read()
    except Exception:
        pass
    path = var("FALCON_RECORD_PATH")
    if path and path != "(null)" and os.path.exists(path):
        # Off the dialplan thread: curl in the background, then remove the file.
        cmd = ["curl", "-s", "--max-time", "10", "-X", "POST", "-H", "Content-Type: audio/wav"]
        if FALCON_TOKEN:
            cmd += ["-H", "X-Falcon-Token: " + FALCON_TOKEN]
        cmd += ["--data-binary", "@" + path, "%s/v1/audio?call_id=%s" % (BASE, urllib.parse.quote(call_id, safe=""))]
        subprocess.Popen(
            ["sh", "-c", 'exec "$0" "$@" >/dev/null 2>&1; rm -f "$FALCON_CLIP"', *cmd],
            env=dict(os.environ, FALCON_CLIP=path),
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )


if __name__ == "__main__":
    main()
