<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional audio fork for a call that is already inside a Class 5 app.

  This is not how a carrier route is transcribed. A carrier route does not
  enter this app. For live traffic, turn Transcription on for the route and
  run falcon-transcript.js. Do not point a route at an extension. Do not
  prefix the number the customer dials.

  If a call is already inside this app, ConnexCS can fork its audio to
  CallerAPI. Replace YOUR_CALLERAPI_KEY and falcon.example.com. Leave
  report=false until you want a confirmed scam filed. {{ cli }}, {{ dest }},
  and {{ call_id }} are placeholders. ConnexCS does not document those names.
-->
<Response>
  <Start>
    <Stream url="wss://api.callerapi.com/api/voice/filter/stream?key=YOUR_CALLERAPI_KEY&amp;webhook=https://falcon.example.com/v1/voice/verdict&amp;report=false&amp;call_id={{ call_id }}&amp;from={{ cli }}" mix_type="mixed">
      <Parameter name="call_id" value="{{ call_id }}" />
      <Parameter name="from" value="{{ cli }}" />
    </Stream>
  </Start>
  <Dial>{{ dest }}</Dial>
</Response>
