# trunk (default): an inbound trunk into a PBX. Scanners are the threat, and
# scores reject. carrier: a class 4 or wholesale ingress. Velocity rules are
# off and scores only flag; deny rules, the spam feed, IP intel block rows,
# and a caller id the customer does not own still reject.
FALCON_PROFILE=trunk
FALCON_LISTEN=0.0.0.0:8090
FALCON_TOKEN=change-me
# Credential Prometheus sends to GET /metrics. Empty means /metrics accepts
# FALCON_TOKEN. Set this so the scraper does not hold the control token.
FALCON_METRICS_TOKEN=

# enforce records the decision and the switch applies it. monitor records
# the decision and tells the switch to continue. Use monitor for the first
# week on a live ingress. This is the start value. Settings changes it at
# runtime, with no restart.
FALCON_MODE=enforce

# Compare this build with the public Falcon release and raise one alert per
# new tag. Falcon does not install the release. Set false on an air-gapped host.
FALCON_UPDATE_CHECK=true
FALCON_UPDATE_INTERVAL=6h

# One hub keeps every switch's events, the shared deny list, and the caller
# counts. Members set FALCON_FLEET_URL to the hub. The hub leaves the URL empty.
# The spare switch runs a second member with the same URL and the same token.
FALCON_FLEET_HUB=false
FALCON_FLEET_URL=
FALCON_FLEET_TOKEN=
FALCON_FLEET_INTERVAL=30s

FALCON_DASHBOARD_USER=admin
FALCON_DASHBOARD_PASSWORD=
FALCON_DB_PATH=/data/falcon.db
FALCON_FAIL_OPEN=true
# An empty token on a non-loopback listen stops startup unless this is true.
FALCON_ALLOW_OPEN=false
FALCON_MAX_BODY_BYTES=65536

# SIP listener for switches with no script hook. Off when empty.
# FALCON_SIP_PEERS is the only gate: list the switch IPs or CIDRs that may send.
# redirect: the switch sends the INVITE here first. 302 means continue, 603
# means drop. Falcon is out of the call.
# bridge: add Falcon to the switch as a carrier and as a customer. A clean
# call gets 503 before any answer, so the switch routes it to the next vendor.
# A suspicious call is carried back to the switch, and both sides are recorded.
FALCON_SIP_LISTEN=
FALCON_SIP_PEERS=
FALCON_SIP_MODE=redirect
FALCON_SIP_REDIRECT_HOST=
FALCON_SIP_TIMEOUT=2s

# Call bridge. The media address goes in SDP. Open the RTP ports on the firewall.
FALCON_MEDIA_IP=
FALCON_RTP_PORT_MIN=20000
FALCON_RTP_PORT_MAX=29999
# Calls past this limit get 503 and are not recorded.
FALCON_BRIDGE_MAX_CALLS=1000
FALCON_BRIDGE_MAX_DURATION=4h
# A bridged call ends when neither side sends audio for this long.
FALCON_RTP_TIMEOUT=30s
# Carry one in N calls that flag for caller_fanout, and one in N clean calls
# so the FAS guard checks ordinary traffic. 0 turns either off. Settings
# changes both at runtime.
FALCON_BRIDGE_FANOUT_EVERY=20
FALCON_BRIDGE_CLEAN_EVERY=0
# suspicious carries the calls worth hearing and answers 503 to the rest.
# all carries every call that is not a hard block, like a PBX. Settings
# changes it at runtime.
FALCON_BRIDGE_CARRY=suspicious
# auto decides per call: X-Falcon-Direction from the switch, else a calling
# number one of your customers owns is outbound, else inbound. inbound or
# outbound fixes one direction for every call.
FALCON_SIP_DIRECTION=auto
# Stereo WAV per bridged call: caller left, callee right. Empty puts the
# folder next to the database.
FALCON_RECORDINGS_DIR=
FALCON_RECORD_MAX_SECONDS=1800
FALCON_RECORDING_RETENTION_DAYS=7

# FAS guard on bridged calls. off, monitor (record and alert), or enforce
# (hold the answer until a person speaks). A tone past the max ringback, or
# an intercept, fails the call with 480. Silence past the hold lets it through.
FALCON_FAS_MODE=monitor
FALCON_FAS_HOLD=2s
FALCON_FAS_MAX_RINGBACK=60s

# Retention. Decisions and raw SIP have separate windows. Both are editable at
# runtime from Settings. These are the defaults.
FALCON_RETENTION_DAYS=30
FALCON_RAW_SIP_RETENTION_DAYS=7
FALCON_STORE_RAW_SIP=true

FALCON_FLAG_SCORE=40
FALCON_CHALLENGE_SCORE=60
FALCON_REJECT_SCORE=80

# Velocity trip points per window.
FALCON_VELOCITY_WINDOW=60s
FALCON_VELOCITY_IP=30
FALCON_VELOCITY_FROM=20
FALCON_VELOCITY_SCAN=15

# STIR/SHAKEN verification. On by default. Defaults load the public STI-PA
# trusted CA list and CRL. Set the URLs to off and give a PEM file on an
# air-gapped host. Budget is how long one screen waits for a cold certificate.
FALCON_SHAKEN=true
FALCON_SHAKEN_CA_URL=https://authenticate-api.iconectiv.com/api/v1/ca-list
FALCON_SHAKEN_CA_FILE=
FALCON_SHAKEN_CRL_URL=https://authenticate-api.iconectiv.com/download/v1/crl
FALCON_SHAKEN_BUDGET=400ms
# Lab rigs only. Accepts plain http x5u URLs.
FALCON_SHAKEN_ALLOW_HTTP=false
# The STI-PA CA list JWS is verified: signature, same-origin signer, expiry,
# sequence rollback. Pin the signing key or give the STI-PA root to tighten.
FALCON_SHAKEN_VERIFY_LIST=true
FALCON_SHAKEN_PA_PIN=
FALCON_SHAKEN_PA_ROOT_FILE=

# Telecom IP intel. CSV of cidr,provider,risk,tags,source. File, URL, or both.
FALCON_IP_INTEL_FILE=
FALCON_IP_INTEL_URL=
FALCON_IP_INTEL_REFRESH=1h
# With a CallerAPI key, true loads the hosted CallerAPI table.
FALCON_IP_INTEL=false

# Zoom demo. seed and swap live stores without a new binary.
FALCON_DEMO=false
FALCON_DEMO_DIR=
FALCON_DEMO_PROFILE=free
FALCON_DEMO_URL=http://127.0.0.1:8090

# Customer bucket (R2, S3, or MinIO). Falcon writes JSONL here when set.
FALCON_S3_ENDPOINT=
FALCON_S3_BUCKET=
FALCON_S3_REGION=auto
FALCON_S3_ACCESS_KEY=
FALCON_S3_SECRET_KEY=
FALCON_S3_PREFIX=falcon

# Telemetry. On by default: redacted screening events go to CallerAPI every
# 30 seconds. The called number, forwarding numbers, the PASSporT, the SDP
# body, recordings, and transcripts never leave the host. Set false and
# restart to opt out. The dashboard shows the state and cannot change it.
# Demo mode never shares. See README "Telemetry".
FALCON_SHARE=true
# Calls with a signal travel as rows. Clean inbound calls travel as hourly
# counts, and one clean call in N travels in full as a sample. 0 sends none.
FALCON_SHARE_CLEAN_EVERY=20

# FCC autopilot. monitor alerts. enforce adds deny rules for upstreams under
# an FCC order. Settings changes the mode at runtime. FALCON_FCC_FILE reads
# the list from disk on a host with no outbound access.
FALCON_FCC=true
FALCON_FCC_MODE=monitor
FALCON_FCC_REFRESH=6h
FALCON_FCC_FILE=

# Behaviour thresholds over the last hour.
FALCON_FANOUT_PER_HOUR=30
FALCON_SEQUENTIAL_N=5

# Voice analysis. off, openai (any OpenAI-compatible speech and chat pair),
# or callerapi (the scan API on CALLERAPI_API_KEY). Clips are taken only on
# a trigger and within the budget; transcripts stay local.
FALCON_VOICE_PROVIDER=off
FALCON_VOICE_STT_BASE_URL=https://api.openai.com/v1
FALCON_VOICE_STT_API_KEY=
FALCON_VOICE_STT_MODEL=whisper-1
FALCON_VOICE_CHAT_BASE_URL=
FALCON_VOICE_CHAT_API_KEY=
FALCON_VOICE_CHAT_MODEL=gpt-4o-mini
FALCON_VOICE_REPORT=true
FALCON_VOICE_SAMPLES_PER_HOUR=60
FALCON_VOICE_SAMPLES_PER_CUSTOMER_HOUR=10
FALCON_VOICE_CLIP_SECONDS=20
FALCON_VOICE_SAMPLE_WITHOUT_AI=true

# Ask Falcon. off, openai (any OpenAI-compatible chat endpoint; defaults to
# the voice chat settings), or callerapi (on CALLERAPI_API_KEY). The value
# card on the Overview needs none of this.
FALCON_ASSISTANT_PROVIDER=off
FALCON_ASSISTANT_BASE_URL=
FALCON_ASSISTANT_API_KEY=
FALCON_ASSISTANT_MODEL=

# Network reputation feed: scores per signer and per sending tool, built
# from every sharing install. Corroboration by default; enforce lets a
# strong signer score reject on its own.
FALCON_REPUTATION=true
FALCON_REPUTATION_ENFORCE=false
FALCON_REPUTATION_REFRESH=1h

# Paid CallerAPI add-ons. Leave empty for the free local engine. A key also
# credits your account for shared telemetry. Business Caller ID is on when
# a key is set. Verify is free for the telco.
CALLERAPI_API_KEY=
CALLERAPI_API_BASE=https://api.callerapi.com
FALCON_SPAM_FEED=false
# Live reputation: a lookup of the calling number on each INVITE. A spam hit
# adds score and flags. It does not listen to audio.
FALCON_VOICE_FIREWALL=false
FALCON_BCID=true
FALCON_FEED_REFRESH=1h

FALCON_UPSELL_FEED_URL=https://callerapi.com
FALCON_UPSELL_FIREWALL_URL=https://callerapi.com/voice-firewall
